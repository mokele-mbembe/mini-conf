APP_ENV=prod
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://mini_conf_app:change-me@postgres.example:5432/mini_conf
STATIC_DIR=/opt/mini-conf/web
INIT_DB_ON_BOOT=false
RUST_LOG=info

# Optional cross-origin admin UI deployment.
# Leave empty for the default same-origin deployment.
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SAME_SITE=lax

# Required only when this server serves static UI assets that connect to another API origin.
CSP_CONNECT_SRC_EXTRA=
